{
  "name": "a11y-widget-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Hebrew accessibility widget for Israeli websites — workspace root",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@shakuf/widget",
    "dev": "npm run dev --workspace=@shakuf/widget",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "size": "npm run size --workspace=@shakuf/widget"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
