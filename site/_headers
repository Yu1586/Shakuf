# Cloudflare Pages headers.
#
# The site is fully self-contained — no external fonts, scripts, analytics or
# images — so the CSP can be genuinely strict rather than decorative. If a
# third-party embed is ever added, this file is the thing that will break
# first, and that is the intended behaviour.
#
# 'unsafe-inline' is present for style-src only. The real reason is the widget:
# it creates two <style> elements of its own (one in its shadow root, one in
# <head>), and style-src governs both. A few inline style attributes on the pages
# need it too, but removing those would not let it go. There is no inline
# script: app.js and shakuf.js are both same-origin files, so script-src stays
# 'self'.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Rebuilt on every deploy, so keep the window short.
/shakuf.js
  Cache-Control: public, max-age=3600

# Pages reference these with a ?v=<content hash> written by the build, so a
# change always gets a new URL and the file itself can sit in caches for a
# day. Before this they were cached for an hour, and a deploy that changed
# both the HTML and the CSS left returning visitors with new markup on the old
# stylesheet for up to an hour.
/style.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

# Fonts are cached for a year as immutable, so a font file must get a NEW NAME
# whenever it changes (the Rubik files carry their upstream version for that
# reason). Before this they revalidated on every page view.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/shakuf.js.map
  Cache-Control: public, max-age=3600

# Icons change rarely but are not versioned in the file name, so one day.
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-48.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The sharing image is re-rendered rarely and fetched by link previewers.
/og/*
  Cache-Control: public, max-age=86400
