{
  "name": "@a11y-il/widget",
  "version": "0.1.0",
  "private": true,
  "description": "כלי עזר נגישות לאתרים ישראליים — תוסף צד-לקוח, ללא שרת וללא איסוף מידע",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11y.js",
  "jsdelivr": "./dist/a11y.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/a11y.js": "./dist/a11y.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "DISCLAIMER.md"
  ],
  "sideEffects": [
    "./dist/a11y.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "size": "node ../../scripts/size.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
